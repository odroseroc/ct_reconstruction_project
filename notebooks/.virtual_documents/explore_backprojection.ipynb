# Testing how to smear a single projection

from scipy import ndimage

reconstructed = np.zeros(sinogram.shape)
position = 255
angle = theta[position]

projection = sinogram[:,position]
smearedProjection = np.zeros(reconstructed.shape)
for row in range(smearedProjection.shape[1]): # There's probably a more pythonic way of writing this loop...
    smearedProjection[row] = projection
rotatedSmearedProjection = ndimage.rotate(smearedProjection, angle, reshape=False, mode='nearest')

plt.imshow(rotatedSmearedProjection, cmap='gray')





def singleBackProjection(sinogram: "array_like", angles: "array_like", position: int) -> np.array:
    """
    Returns the backprojection (at the correct angle) of a single projection fro a sinogram

    Parameters
    ----------
    sinogram : array_like
        Matrix of size (n,m) containing the sinogram
    angles : array_like
        Array containing the angles corresponding to each projection
    position : int
        The position of the pixel column within the sinogram containing the 
        desired projection.

    Returns
    -------
    np.array
        The matrix of size (n,m) containing the backprojection (the "smeared"
        projection) at the correct angle that it was originally taken.
    """

    zeroDegBackProjection = np.zeros(sinogram.shape) # The backprojection is first generated as if it comes from the 0° projection, then rotated at the correct angle
    angle = angles[position]
    # for row in range(zeroDegBackProjection.shape[1]):
    #     zeroDegBackProjection[row] = sinogram[:,position]
    zeroDegBackProjection[:] = sinogram[:, position][np.newaxis, :]
    return ndimage.rotate(zeroDegBackProjection, angle, reshape=False, mode='nearest')

# Test here:

position = 0
print(theta[position])
bp = singleBackProjection(sinogram, theta, position)
plt.imshow(bp, cmap='gray')





BackProjectionSum = np.zeros(sinogram.shape)
for position in range(theta.size):
    bp = singleBackProjection(sinogram, theta, position)
    BackProjectionSum += bp
plt.imshow(BackProjectionSum, cmap='gray')





def backProjection(sinogram: "array_like", angles: "array_like") -> np.array:
    """
    Returns the backprojection summation image of a sinogram

    Parameters
    ----------
    sinogram : array_like
        Matrix of size (n,m) containing the sinogram
    angles : array_like
        Array containing the angles corresponding to each projection

    Returns
    -------
    np.array
        The backprojection summation (no filter)
    """

    backprojection_sum = np.zeros(sinogram.shape)
    for position in range(angles.size):
        bp = singleBackProjection(sinogram, theta, position)
        backprojection_sum += bp
    return backprojection_sum

#Test here:

backpjt = backProjection(sinogram, theta)
plt.imshow(backpjt, cmap='gray')



